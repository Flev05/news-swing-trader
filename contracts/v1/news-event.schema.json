{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.news-swing.local/v1/news-event.schema.json",
  "title": "News Event v1",
  "description": "An immutable normalized news revision accepted at the inference boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "source",
    "source_created_at",
    "source_updated_at",
    "received_at",
    "deadline_at",
    "content_hash",
    "headline",
    "content",
    "affected_symbols"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "news_id", "revision_id", "canonical_url"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]+$"
        },
        "news_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": ".*\\S.*"
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": ".*\\S.*"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    },
    "source_created_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "source_updated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "received_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "deadline_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "content_hash": {
      "description": "Server-computed lowercase SHA-256 of the canonical news content bytes.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "readOnly": true
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": ".*\\S.*"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": ".*\\S.*"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "pattern": ".*\\S.*"
        }
      },
      "anyOf": [
        {
          "required": ["summary"]
        },
        {
          "required": ["body"]
        }
      ]
    },
    "affected_symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ticker"
      }
    }
  },
  "$defs": {
    "ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,4}(?:[.-][A-Z])?$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
